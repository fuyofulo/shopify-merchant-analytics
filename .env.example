# Copy to .env.local and fill in. .env.local is git-ignored.

# Required. Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. One OpenRouter model ID, or a comma-separated list tried in order.
# Defaults to free models with tool calling (see src/lib/assistant/model.ts).
# OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free,inclusionai/ling-3.2-flash:free

# Optional. The date the assistant treats as "today" (YYYY-MM-DD).
# Defaults to the last day in the data, 2025-10-27.
# STORE_TODAY=2025-10-27
